# Backend Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration
# For local zero-docker development with SQLite:
DATABASE_URL="file:./dev.db"
# For PostgreSQL in production or local Postgres:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trading_journal?schema=public"

# Authentication
JWT_SECRET="crypto-terminal-super-secret-jwt-key-change-in-prod-12345678"
JWT_EXPIRES_IN="7d"

# Redis Cache & PubSub (Leave empty to use automatic built-in In-Memory Cache)
REDIS_URL=""

# Binance Public Market Data Endpoints
BINANCE_API_URL="https://api.binance.com"
BINANCE_WS_URL="wss://stream.binance.com:9443/ws"

# AI Service (OpenAI API - optional, falls back automatically to built-in rule-based trade analyzer)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# File Storage (local, cloudinary, or s3)
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"

# Client Configuration
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_WS_URL="ws://localhost:3001/ws"
NEXT_PUBLIC_DEMO_MODE="false"
