{
  "name": "crypto-trading-journal-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Production-Quality Crypto Trading Analysis & Automatic Trading Journal Platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"api,web\" -c \"cyan,magenta\" \"npm run dev --workspace=apps/api\" \"npm run dev --workspace=apps/web\"",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:calc": "npm run test --workspace=packages/calculations",
    "test:ind": "npm run test --workspace=packages/indicators",
    "test:e2e": "playwright test",
    "db:push": "npm run db:push --workspace=apps/api",
    "db:seed": "npm run db:seed --workspace=apps/api",
    "db:studio": "npm run db:studio --workspace=apps/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "autoprefixer": "^10.5.5",
    "clsx": "^2.1.1",
    "lightweight-charts": "^4.2.1",
    "lucide-react": "^1.41.0",
    "next": "^14.2.24",
    "postcss": "^8.5.28",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  }
}
